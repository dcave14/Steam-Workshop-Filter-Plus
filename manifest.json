{
    "manifest_version": 3,
    "name": "Steam Workshop Filter Plus",
    "version": "1.3.1",
    "description": "Filter Steam Workshop content by hiding subscribed items and filtering by star rating. Find new, high-quality content more easily.",
    "icons": {
        "128": "Steam-Workshop-Filter-Plus-Icon.png"
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": [
                "*://*.steamcommunity.com/workshop/*",
                "*://*.steamcommunity.com/sharedfiles/filedetails/*",
                "*://*.steamcommunity.com/app/*/workshop/*"
            ],
            "js": ["steam-dom.js", "content.js", "collection-row-align.js", "sort-popover-fit.js", "saved-filters.js"],
            "css": ["styles.css", "saved-filters.css"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.steamcommunity.com/workshop/*",
                "*://*.steamcommunity.com/app/*/workshop/*"
            ],
            "js": ["hydration-signal.js", "search-terms-hook.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}
