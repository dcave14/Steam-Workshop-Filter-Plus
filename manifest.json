{
    "manifest_version": 3,
    "name": "Steam Workshop Filter Plus",
    "version": "1.4.0",
    "description": "Hide subscribed Steam Workshop items, filter by star rating, and save keyword and author filters per game.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": [
                "*://*.steamcommunity.com/workshop/*",
                "*://*.steamcommunity.com/sharedfiles/filedetails/*",
                "*://*.steamcommunity.com/app/*/workshop/*"
            ],
            "js": ["workshop-metadata.js", "collection-descriptions.js", "steam-dom.js", "content.js", "collection-row-align.js", "sort-popover-fit.js", "pluralize.js", "title-word-inflection.js", "saved-filters.js", "collection-sizes.js"],
            "css": ["styles.css", "saved-filters.css"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.steamcommunity.com/workshop/*",
                "*://*.steamcommunity.com/app/*/workshop/*"
            ],
            "js": ["hydration-signal.js", "search-terms-hook.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["*://*.steamcommunity.com/sharedfiles/filedetails/*"],
            "js": ["collection-subscriptions.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}
