{
    "manifest_version": 3,
    "name": "Steam Workshop Filter Plus",
    "version": "1.5.4",
    "description": "Hide subscribed Workshop items, filter ratings, and save keyword, author, and dependency filters per game.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["storage"],
    "action": { "default_popup": "src/popup/popup.html", "default_title": "Steam Workshop Filter Plus", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
    "optional_host_permissions": ["https://api.steampowered.com/*"],
    "host_permissions": ["https://steam-workshop-data.prodbycave.workers.dev/*"],
    "background": { "service_worker": "src/background/steam-api.js" },
    "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
    "content_scripts": [
        {
            "matches": [
                "*://*.steamcommunity.com/workshop/*",
                "*://*.steamcommunity.com/sharedfiles/filedetails/*",
                "*://*.steamcommunity.com/app/*/workshop/*"
            ],
            "js": ["src/core/api-client.js", "src/core/workshop-metadata.js", "src/collections/collection-descriptions.js", "src/core/workshop-dependencies.js", "src/core/filter-matching.js", "src/core/steam-dom.js", "src/core/content.js", "src/collections/collection-row-align.js", "src/workshop/sort-popover-fit.js", "src/core/pluralize.js", "src/core/title-word-inflection.js", "src/workshop/saved-filters.js", "src/collections/collection-sizes.js", "src/workshop/workshop-sidebar.js", "src/workshop/filter-bar-pinning.js", "src/workshop/workshop-appearance.js", "src/workshop/preview-motion.js", "src/workshop/workshop-result-count.js", "src/collections/collection-layout.js", "src/collections/linked-collections.js", "src/steamcmd/steamcmd.js"],
            "css": ["src/core/styles.css", "src/workshop/saved-filters.css", "src/workshop/workshop-sidebar.css", "src/workshop/workshop-appearance.css", "src/collections/collection-layout.css", "src/steamcmd/steamcmd.css"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.steamcommunity.com/workshop/*",
                "*://*.steamcommunity.com/app/*/workshop/*"
            ],
            "js": ["src/page/hydration-signal.js", "src/page/search-terms-hook.js", "src/page/browse-integration.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["*://*.steamcommunity.com/sharedfiles/filedetails/*"],
            "js": ["src/page/collection-subscriptions.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}
